# Clave para proteger el servidor (recomendado en producción)
MCP_API_KEY=cambia-esta-clave
# URL pública del servidor, para incluir enlaces de descarga de cada gráfico
PUBLIC_BASE_URL=https://tu-servidor.example.com
PORT=8000
# Opcional: carpeta para que los datasets sobrevivan reinicios
# MPLSOCCER_MCP_DATA_DIR=/data
# MPLSOCCER_MCP_DATASET_TTL_HOURS=72
# MPLSOCCER_MCP_MAX_ROWS=500000
# MPLSOCCER_MCP_MAX_BODY_MB=25
# MPLSOCCER_MCP_ALLOW_URLS=true
